# ============================================================
# Cloud Resource Benchmark — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to Git.
# ============================================================

# --- Flask ---
FLASK_ENV=development
FLASK_SECRET_KEY=change-me-to-a-random-secret-key
FLASK_PORT=5000

# --- PostgreSQL ---
DB_HOST=db
DB_PORT=5432
DB_NAME=benchmark_db
DB_USER=benchmark_user
DB_PASSWORD=change-me-to-a-strong-password
DB_MIN_CONN=2
DB_MAX_CONN=30

# --- Redis Cache ---
REDIS_HOST=cache
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# --- Experiment Metadata ---
# Identify which environment this instance is running in.
# Examples: Local | Cloud-1 | Cloud-2 | Cloud-3
ENVIRONMENT_NAME=Local

# Describe the server hardware/VM configuration being tested.
# Examples: "1 vCPU / 1 GB RAM" | "2 vCPU / 2 GB RAM" | "4 vCPU / 4 GB RAM"
SERVER_CONFIGURATION=Local Machine

